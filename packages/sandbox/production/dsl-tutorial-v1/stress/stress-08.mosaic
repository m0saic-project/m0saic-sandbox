      "layers": [
        {
          "content": {
            "kind": "literal",
            "text": "Read split count — 3 columns."
          },
          "style": {
            "fontSize": 22,
            "fontColor": "#3C4763"
          },
          "placement": {
            "fit": "contain",
            "hAlign": "left",
            "vAlign": "middle"
          },
          "overlay": {
            "enable": "(gte(t,0.500)*lt(t,2.300))"
          }
        },
        {
          "content": {
            "kind": "literal",
            "text": "Split into 3 columns."
          },
          "style": {
            "fontSize": 22,
            "fontColor": "#3C4763"
          },
          "placement": {
            "fit": "contain",
            "hAlign": "left",
            "vAlign": "middle"
          },
          "overlay": {
            "enable": "(gte(t,2.300)*lt(t,4.100))"
          }
        },
        {
          "content": {
            "kind": "literal",
            "text": "Emit tile 1 — 640×1080 at (0, 0)."
          },
          "style": {
            "fontSize": 22,
            "fontColor": "#3C4763"
          },
          "placement": {
            "fit": "contain",
            "hAlign": "left",
            "vAlign": "middle"
          },
          "overlay": {
            "enable": "(gte(t,4.100)*lt(t,5.900))"
          }
        },
        {
          "content": {
            "kind": "literal",
            "text": "Advance to the next sibling."
          },
          "style": {
            "fontSize": 22,
            "fontColor": "#3C4763"
          },
          "placement": {
            "fit": "contain",
            "hAlign": "left",
            "vAlign": "middle"
          },
          "overlay": {
            "enable": "(gte(t,5.900)*lt(t,7.700))+(gte(t,9.500)*lt(t,11.300))+(gte(t,16.700)*lt(t,18.500))"
          }
        },
        {
          "content": {
            "kind": "literal",
            "text": "Null slot — reserve space, paint nothing."
          },
          "style": {
            "fontSize": 22,
            "fontColor": "#3C4763"
          },
          "placement": {
            "fit": "contain",
            "hAlign": "left",
            "vAlign": "middle"
          },
          "overlay": {
            "enable": "(gte(t,7.700)*lt(t,9.500))"
          }
        },
        {
          "content": {
            "kind": "literal",
            "text": "Read split count — 2 rows."
          },
          "style": {
            "fontSize": 22,
            "fontColor": "#3C4763"
          },
          "placement": {
            "fit": "contain",
            "hAlign": "left",
            "vAlign": "middle"
          },
          "overlay": {
            "enable": "(gte(t,11.300)*lt(t,13.100))"
          }
        },
        {
          "content": {
            "kind": "literal",
            "text": "Split into 2 rows."
          },
          "style": {
            "fontSize": 22,
            "fontColor": "#3C4763"
          },
          "placement": {
            "fit": "contain",
            "hAlign": "left",
            "vAlign": "middle"
          },
          "overlay": {
            "enable": "(gte(t,13.100)*lt(t,14.900))"
          }
        },
        {
          "content": {
            "kind": "literal",
            "text": "Passthrough — donate 540px forward (carry now 540px), claimed by the next tile."
          },
          "style": {
            "fontSize": 22,
            "fontColor": "#3C4763"
          },
          "placement": {
            "fit": "contain",
            "hAlign": "left",
            "vAlign": "middle"
          },
          "overlay": {
            "enable": "(gte(t,14.900)*lt(t,16.700))"
          }
        },
        {
          "content": {
            "kind": "literal",
            "text": "Emit tile 2 — 640×1080 at (1280, 0). Absorbs 540px donated by a passthrough."
          },
          "style": {
            "fontSize": 22,
            "fontColor": "#3C4763"
          },
          "placement": {
            "fit": "contain",
            "hAlign": "left",
            "vAlign": "middle"
          },
          "overlay": {
            "enable": "(gte(t,18.500)*lt(t,20.300))"
          }
        },
        {
          "content": {
            "kind": "literal",
            "text": "Close split — restore the parent region."
          },
          "style": {
            "fontSize": 22,
            "fontColor": "#3C4763"
          },
          "placement": {
            "fit": "contain",
            "hAlign": "left",
            "vAlign": "middle"
          },
          "overlay": {
            "enable": "(gte(t,20.300)*lt(t,24.800))"
          }
        }
      ],
