          },
          "layers": [
            {
              "content": {
                "kind": "literal",
                "text": "Read split count — 2 rows."
              },
              "style": {
                "fontSize": 22,
                "fontColor": "#AEB9D4"
              },
              "placement": {
                "fit": "contain",
                "hAlign": "left",
                "vAlign": "middle"
              },
