            },
            {
              "content": {
                "kind": "literal",
                "text": "Split into 2 rows."
              },
              "style": {
                "fontSize": 22,
                "fontColor": "#AEB9D4"
              },
              "placement": {
                "fit": "contain",
                "hAlign": "left",
