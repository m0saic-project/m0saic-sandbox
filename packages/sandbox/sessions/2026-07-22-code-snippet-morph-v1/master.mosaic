          "type Template = {\n  id: string;\n  render(): Promise<Artifact>;\n};",
          "type Template = {\n  id: string;\n  render(): Promise<Artifact>;\n};\n\nconst ecosystem = new Map<string, Template>();",
          "type Template = {\n  id: string;\n  render(): Promise<Artifact>;\n};\n\nconst ecosystem = new Map<string, Template>();\n\nexport function publish(template: Template) {\n  ecosystem.set(template.id, template);\n  return {\n    template,\n    availableToEveryone: true,\n  };\n}"
        ],
